#!/usr/bin/env python3
"""ccs: Claude Code sessions. Open one, or archive it out of /resume (nothing is deleted).

  ccs                 picker (a plain list when piped)
  ccs ID...           archive (an ID prefix is enough); a session that is
                      still open is archived as soon as it closes
  ccs -l              list archived sessions
  ccs -r ID...        restore, or cancel a pending archive
  ccs --restore-all   restore every archived session of every project
  ccs --update        update this install (git pull, then install.sh)
  ccs --uninstall     restore every archived session, then remove ccs, its plugin and its data
  -p DIR              project DIR instead of the current directory
  -f                  archive now even if ccs cannot tell the session is closed (only when
                      you know no claude is using it)

Every run also archives the copies Claude Code makes when a conversation is moved to the
background (exiting while an agent runs), keeping the most complete one. /branch is not affected.

picker keys: up/down select, ctrl+a archive/restore, enter open, q quit
  enter opens a session the way that makes no copy of it: `claude attach` while it runs
  in the background, `claude --resume` otherwise
  [A] archived   [P] archived when it closes   *  open in a running claude
"""
import argparse
import curses
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

VERSION = "0.7.0"
CLAUDE = Path.home() / ".claude"
PROJECTS = CLAUDE / "projects"
DATA = Path(os.environ.get("CCS_DIR") or Path.home() / ".local/share/ccs")
PENDING = DATA / ".pending"
KEEP = DATA / ".keep"  # copies restored by hand, which archive_copies leaves alone
QUIET_SECONDS = 10  # a closed session is left alone until its last writes have settled


def project_key(path):
    return re.sub(r"[^a-zA-Z0-9]", "-", str(Path(path).resolve()))


def session_ids(folder):
    return {p.name.split(".")[0] for p in folder.glob("*.jsonl")} if folder.is_dir() else set()


def session_files(folder, sid):
    return [p for p in folder.iterdir() if p.name.split(".")[0] == sid]


def newest_mtime(folder, sid):
    return max(p.stat().st_mtime for p in session_files(folder, sid))


def open_sessions():
    """Ids of sessions held by a running claude (it registers in ~/.claude/sessions/<pid>.json),
    or None when that cannot be told: no registry, a format this script does not know, or an
    entry that stays unreadable (claude rewrites them, so a read can land mid-write)."""
    registry = CLAUDE / "sessions"
    if not registry.is_dir():
        return None
    ids = set()
    for f in registry.glob("*.json"):
        for attempt in range(3):
            try:
                d = json.loads(f.read_text())
                break
            except FileNotFoundError:
                d = None  # its claude exited meanwhile
                break
            except (OSError, ValueError):
                time.sleep(0.1)
        else:
            return None
        if d is None:
            continue
        if not isinstance(d, dict) or not isinstance(d.get("pid"), int) or not d.get("sessionId"):
            return None
        try:
            os.kill(d["pid"], 0)
        except PermissionError:
            pass  # alive, just not ours to signal
        except OSError:
            continue
        ids.add(d["sessionId"])
    return ids


def is_open(folder, sid, opened):
    """Whether sid may still be in use. Without a readable registry nothing counts as closed:
    a file left untouched for a while does not mean its claude has exited."""
    if opened is None:
        return True
    return sid in opened or time.time() - newest_mtime(folder, sid) < QUIET_SECONDS


def info(folder, sid):
    """(last activity time, title), picked the same way /resume does:
    custom title (/rename) > AI title > summary > first prompt."""
    titles, first_prompt, last = {}, None, None
    for f in sorted(folder.glob(f"{sid}*.jsonl")):
        for line in f.open(errors="ignore"):
            d = record(line)
            t = d.get("type")
            if t in ("custom-title", "ai-title", "summary"):
                name = d.get("customTitle") or d.get("aiTitle") or d.get("summary")
                if isinstance(name, str):
                    titles[t] = name
            elif t == "user" and first_prompt is None and not d.get("isSidechain"):
                message = d.get("message")
                c = message.get("content") if isinstance(message, dict) else None
                if isinstance(c, str) and not c.startswith("<"):
                    first_prompt = c
            if isinstance(d.get("timestamp"), str):
                last = max(last or "", d["timestamp"])
    name = titles.get("custom-title") or titles.get("ai-title") or titles.get("summary") or first_prompt
    try:
        when = datetime.fromisoformat(last.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        when = newest_mtime(folder, sid)
    return when, (name or "(empty)").replace("\n", " ")[:60]


def record(line):
    """A transcript line as a dict; {} for anything else, so a record this script does not
    understand is skipped instead of breaking the list."""
    try:
        d = json.loads(line)
    except ValueError:
        return {}
    return d if isinstance(d, dict) else {}


def resolve(folder, prefix):
    """The one session id in folder starting with prefix. A full id is also looked up in
    every project, so callers that only know the id (the /archive plugin) need no -p."""
    matches = [s for s in session_ids(folder) if s.startswith(prefix)]
    if not matches and len(prefix) == 36:
        for other in folder.parent.glob("*/"):
            if prefix in session_ids(other):
                return other, prefix
    if len(matches) != 1:
        raise ValueError(f"'{prefix}': {'no' if not matches else 'ambiguous'} match in {folder}")
    return folder, matches[0]


def move(src, dst, sid, touch=False):
    files = session_files(src, sid)
    dst.mkdir(parents=True, exist_ok=True)
    for p in files:
        if (dst / p.name).exists():
            raise ValueError(f"{dst / p.name} already exists, not overwriting")
    moved = []
    try:
        for p in files:
            shutil.move(str(p), str(dst / p.name))
            moved.append(p)
    except OSError as e:  # put back what already moved, so a session is never split in two
        for p in reversed(moved):
            shutil.move(str(dst / p.name), str(p))
        raise ValueError(f"{sid[:8]}: could not move {src} -> {dst}: {e}; nothing was moved")
    if touch:  # so Claude's cleanupPeriodDays does not delete a long-archived session on restore
        for p in files:
            os.utime(dst / p.name)


def archive_dir(live_folder):
    return DATA / live_folder.name


def archive(live, prefix, opened, force=False):
    folder, sid = resolve(live, prefix)
    if opened is None and not force:
        raise ValueError(f"{sid[:8]}: cannot tell whether it is open (Claude's session registry "
                         f"is unreadable). If no claude is using it, run: ccs -f {sid[:8]}")
    if is_open(folder, sid, opened) and not force:
        PENDING.mkdir(parents=True, exist_ok=True)
        (PENDING / sid).write_text(str(folder))
        return f"{sid[:8]} is open: it will be archived when it closes"
    move(folder, archive_dir(folder), sid)
    (PENDING / sid).unlink(missing_ok=True)
    return f"{sid[:8]} archived"


def restore(live, prefix):
    pending = [p.name for p in PENDING.glob(f"{prefix}*")] if PENDING.is_dir() else []
    archived = [s for s in session_ids(archive_dir(live)) if s.startswith(prefix)]
    if len(pending) + len(archived) > 1:
        raise ValueError(f"'{prefix}': ambiguous, matches " + ", ".join(s[:8] for s in pending + archived))
    if pending:
        (PENDING / pending[0]).unlink()
        return f"{pending[0][:8]} will no longer be archived when it closes"
    folder, sid = resolve(archive_dir(live), prefix)
    move(folder, PROJECTS / folder.name, sid, touch=True)
    KEEP.mkdir(parents=True, exist_ok=True)
    (KEEP / sid).touch()
    return f"{sid[:8]} restored"


def run_pending(wait=0):
    """Archive the sessions marked pending once they are no longer open."""
    deadline = time.time() + wait
    while True:
        opened = open_sessions()
        for marker in PENDING.glob("*") if PENDING.is_dir() else []:
            folder, sid = Path(marker.read_text().strip()), marker.name
            if not folder.is_dir() or sid not in session_ids(folder):
                marker.unlink()
            elif not is_open(folder, sid, opened):
                try:
                    move(folder, archive_dir(folder), sid)
                    marker.unlink()
                except ValueError as e:
                    print(f"ccs: pending {sid[:8]}: {e}", file=sys.stderr)
        if not (PENDING.is_dir() and any(PENDING.iterdir())) or time.time() >= deadline:
            return
        time.sleep(1)


def copies(folder, opened):
    """Copies Claude Code made when it moved a conversation to a background session, except the
    most complete one of each conversation (most messages, then the newest). Claude marks such a
    move with a "continued-in" record; /branch and --fork-session write none, so deliberate
    branches are never returned, and neither is a copy that is open or that was restored by hand."""
    ids = session_ids(folder)
    group = {sid: sid for sid in ids}

    def root(sid):
        while group[sid] != sid:
            sid = group[sid]
        return sid

    size = {}
    for sid in ids:
        n = 0
        for f in folder.glob(f"{sid}*.jsonl"):
            for line in f.open(errors="ignore"):
                if '"type":"continued-in"' in line:
                    target = record(line).get("continuedInSessionId")
                    if target in ids:
                        group[root(target)] = root(sid)
                elif '"type":"user"' in line or '"type":"assistant"' in line:
                    n += 1
        size[sid] = (n, newest_mtime(folder, sid))

    members = {}
    for sid in ids:
        members.setdefault(root(sid), []).append(sid)
    out = []
    for sids in members.values():
        keep = max(sids, key=size.get)
        out += [(sid, keep) for sid in sids
                if sid != keep and not (KEEP / sid).exists() and not is_open(folder, sid, opened)]
    return out


def archive_copies(live):
    for sid, keep in copies(live, open_sessions()):
        move(live, archive_dir(live), sid)
        print(f"{sid[:8]} archived: a copy of {keep[:8]}", file=sys.stderr)


def rows(live):
    opened, archive = open_sessions(), archive_dir(live)
    pending = {p.name for p in PENDING.glob("*")} if PENDING.is_dir() else set()
    out = []
    for folder in (live, archive):
        for sid in session_ids(folder):
            if folder == archive:
                state = "[A]"
            elif sid in pending:
                state = "[P]"
            else:
                state = " * " if is_open(folder, sid, opened) else "   "
            out.append((*info(folder, sid), sid, state))
    return sorted(out, reverse=True)


def show(folder):
    found = sorted(((*info(folder, sid), sid) for sid in session_ids(folder)), reverse=True)
    if not found:
        print(f"(no sessions in {folder})")
    for when, name, sid in found:
        size = sum(p.stat().st_size for p in folder.glob(f"{sid}*.jsonl"))
        print(f"{sid[:8]}  {datetime.fromtimestamp(when):%m-%d %H:%M}  {size // 1024:>6}K  {name}")


def pick(stdscr, live):
    """Return the command that opens the chosen session, or None."""
    curses.curs_set(0)
    curses.use_default_colors()
    items, cur, msg = rows(live), 0, ""
    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        stdscr.addnstr(0, 0, "up/down select  ctrl+a archive/restore  enter open  q quit", w - 1, curses.A_BOLD)
        top = max(0, cur - (h - 4))
        for i, (when, name, sid, state) in enumerate(items[top:top + h - 3], top):
            line = f"{state} {sid[:8]}  {datetime.fromtimestamp(when):%m-%d %H:%M}  {name}"
            attr = (curses.A_REVERSE if i == cur else 0) | (curses.A_DIM if state in ("[A]", "[P]") else 0)
            stdscr.addnstr(i - top + 1, 0, line, w - 1, attr)
        if not items:
            stdscr.addnstr(1, 0, "(no sessions)", w - 1)
        stdscr.addnstr(h - 1, 0, msg, w - 1)
        key, msg = stdscr.getch(), ""
        if key in (ord("q"), 27):
            return None
        if not items:
            continue
        sid, state = items[cur][2], items[cur][3]
        if key in (curses.KEY_UP, ord("k")):
            cur = max(0, cur - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            cur = min(len(items) - 1, cur + 1)
        elif key == 1:  # ctrl+a
            try:
                msg = restore(live, sid) if state in ("[A]", "[P]") else archive(live, sid, open_sessions())
            except ValueError as e:
                msg = str(e)
            items = rows(live)
            cur = next((i for i, r in enumerate(items) if r[2] == sid), 0)
        elif key in (curses.KEY_ENTER, 10, 13):
            if state == "[A]":
                msg = "archived session: press ctrl+a to restore it first"
            else:
                argv, msg = open_command(sid)
                if argv:
                    return argv


def open_command(sid):
    """How to enter sid without Claude making a copy of it: `claude attach` while a background
    session runs it, `claude --resume` when nothing does. Returns (argv, None) or (None, why not)."""
    try:
        r = subprocess.run(["claude", "agents", "--json"], capture_output=True, text=True, timeout=30)
        agents = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        agents = []
    for a in agents:
        if a.get("sessionId") == sid and a.get("kind") == "background":
            return ["claude", "attach", a["id"]], None
        if a.get("sessionId") == sid:
            return None, f"{sid[:8]} is open in another claude window: switch to that window"
    return ["claude", "--resume", sid], None


def update():
    repo = Path(__file__).resolve().parent.parent
    if not (repo / ".git").exists():
        sys.exit(f"{repo} is not a git checkout; reinstall with install.sh")
    subprocess.run(["git", "-C", str(repo), "pull", "--ff-only"], check=True)
    subprocess.run([str(repo / "install.sh")], check=True)  # links tools added since, moves old data
    subprocess.run([sys.executable, str(Path(__file__).resolve()), "--version"])


def uninstall():
    """Undo everything ccs did: archived sessions back where Claude keeps them, then the plugin,
    the command links and ccs's own data. Stops before removing anything if a restore fails."""
    repo = Path(__file__).resolve().parent.parent
    archived = [(folder, sid) for folder in DATA.glob("*/") for sid in session_ids(folder)]
    if sys.stdin.isatty():
        answer = input(f"Restore {len(archived)} archived session(s) and remove ccs? [y/N] ")
        if answer.strip().lower() != "y":
            sys.exit("cancelled")
    for folder, sid in archived:
        move(folder, PROJECTS / folder.name, sid, touch=True)
        print(f"{sid[:8]} restored")

    for argv in (["claude", "plugin", "uninstall", "ccs@cc-tools"],
                 ["claude", "plugin", "marketplace", "remove", "cc-tools"]):
        try:
            subprocess.run(argv, capture_output=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            print(f"could not run: {' '.join(argv)}")
    for link in (Path.home() / ".local/bin").glob("*"):
        if link.is_symlink() and (repo / "bin") in link.resolve().parents:
            link.unlink()
            print(f"removed {link}")

    # Only what ccs itself made, in case CCS_DIR points somewhere shared.
    for marker_dir in (PENDING, KEEP):
        for marker in marker_dir.glob("*") if marker_dir.is_dir() else []:
            marker.unlink()
    for d in [PENDING, KEEP, *DATA.glob("*/"), DATA]:
        try:
            d.rmdir()
        except OSError:
            pass
    if DATA.exists():
        print(f"left {DATA}: it holds files ccs did not make")
    print(f"ccs is uninstalled. To delete its code too: rm -rf {repo}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("ids", nargs="*")
    ap.add_argument("-l", "--list-archived", action="store_true")
    ap.add_argument("-r", "--restore", action="store_true")
    ap.add_argument("--restore-all", action="store_true")
    ap.add_argument("-p", "--project", default=".")
    ap.add_argument("-f", "--force", action="store_true")
    ap.add_argument("--pending", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--wait", type=int, default=0, help=argparse.SUPPRESS)
    ap.add_argument("--update", action="store_true")
    ap.add_argument("--uninstall", action="store_true")
    ap.add_argument("--version", action="version", version=f"ccs {VERSION}")
    args = ap.parse_args()

    live = PROJECTS / project_key(args.project)
    try:
        if args.uninstall:
            return uninstall()
        run_pending(args.wait if args.pending else 0)
        archive_copies(live)
        if args.pending:
            pass
        elif args.update:
            update()
        elif args.restore_all:
            for folder in DATA.glob("*/"):
                for sid in session_ids(folder):
                    print(restore(PROJECTS / folder.name, sid))
        elif args.ids:
            opened = open_sessions()
            for prefix in args.ids:
                print(restore(live, prefix) if args.restore else archive(live, prefix, opened, args.force))
        elif args.list_archived or args.restore:
            show(archive_dir(live))
        elif sys.stdout.isatty():
            argv = curses.wrapper(pick, live)
            if argv:
                os.chdir(args.project)
                os.execvp(argv[0], argv)
        else:
            show(live)
    except ValueError as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
